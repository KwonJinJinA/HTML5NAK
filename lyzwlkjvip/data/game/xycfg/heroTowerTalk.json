{"index":{"id":0,"type":1,"res":2,"name":3,"msg":4,"time":5},"data":[["1",1,"npc_herotower","小姐姐","多谢小哥哥救命之恩!",3000],["2",1,"npc_njk","小哥哥","举手之劳，何足挂齿。",3000],["3",1,"npc_herotower","小姐姐","小女子无以为报，我还有个妹妹也被他们抓了，你要是能救她回来，我就把她许配给你。",3000],["4",1,"npc_njk","小哥哥","姑娘头前带路，我与邪恶不共戴天。",3000],["5",1,"npc_herotower","小姐姐","少侠稍安勿躁，待我探查一番先，再见。",3000],["6",2,"npc_herotower","小姐姐","救命啊~小哥哥！！",3000],["7",2,"npc_njk","小哥哥","咦？有人喊救命，哈哈行侠仗义的机会来了",3000],["8",2,"NPC_moseng","小兵甲","我劝你不要多管闲事，不然的话......",3000],["9",2,"npc_njk","小哥哥","好的，我这就走。",3000],["10",2,"npc_herotower","小姐姐","这里有美女…",3000],["11",2,"npc_njk","小哥哥","姑娘不要着急，我辈行走江湖，自当行侠仗义，打抱不平。",3000],["12",2,"NPC_moseng","小兵甲","he~ tui~！",3000],["13",3,"npc_njk","小哥哥","也不知道刚才的小姐姐跑哪儿去了？",3000],["14",3,"npc_njk","小哥哥","这些人哪儿来的啊，真讨厌。",3000],["15",4,"npc_njk","小哥哥","咦？这是啥玩意",3000],["16",4,"npc_herotower2","小姐姐","这是攻击宝石，拾取攻击宝石可以倍数提升攻击力。",3000],["17",4,"npc_njk","小哥哥","哇~我感觉充满了力量！！！",3000],["18",5,"npc_herotower2","小姐姐","救命啊~小哥哥！！",3000],["19",5,"npc_njk","小哥哥","…...又是你？",3000],["20",5,"npc_herotower2","小姐姐","不是我，我是妹妹~",3000],["21",5,"npc_njk","小哥哥","听起来好像有哪里不太对的样子。",3000],["22",6,"npc_herotower2","小姐姐","那个，多谢少侠，再次救命之恩。",3000],["23",6,"npc_njk","小哥哥","为什么说再，你不是妹妹么？",3000],["24",6,"npc_herotower2","小姐姐","呃，其实是这样的…",3000],["25",6,"npc_njk","小哥哥","好吧，懂了，不用解释，再见！",3000],["26",7,"npc_herotower2","小姐姐","小哥哥，这边来~",3000],["27",7,"npc_njk","小哥哥","嗯？怎么老是你？",3000],["28",7,"npc_herotower2","小姐姐","嘘，小点声~",3000],["29",7,"NPC_moseng","小兵甲","谁在那边说话？",3000],["30",8,"npc_herotower2","小姐姐","（突然大声）你带着东西快走，不要管我。",3000],["31",8,"NPC_moseng","小兵甲","想走，没那么容易。",3000],["32",9,"npc_njk","小哥哥","哎，终于摆脱了，真的烦~",3000],["33",9,"npc_njk","小哥哥","好像有哪里不对，我是不是被耍了？",3000],["34",10,"npc_njk","小哥哥","最近这里出现这么多陌生人，又总是遇到哪个奇怪的女孩子，我得多留点意。",3000],["35",11,"npc_njk","小哥哥","嗯？这是什么，看起来像是一份地图",3000],["36",11,"npc_njk","小哥哥","看起来就在这附近",3000],["37",11,"npc_njk","小哥哥","这些人恐怕也是被这个地图带过来的",3000],["38",20,"npc_njk","小哥哥","哈，又是你，这次看你往哪儿跑？",3000],["39",20,"npc_herotower2","小姐姐","你谁啊？我不认识你，你不要过来啊。",3000],["40",20,"npc_njk","小哥哥","少来这套，是不是又想说你是妹妹？",3000],["41",20,"npc_herotower2","小姐姐","不是，我是姐姐，之前的是妹妹…...",3000],["42",20,"npc_njk","小哥哥","继续编，你看我信不信就完了。",3000],["43",30,"npc_herotower2","小姐姐","小哥哥，别生气了，我告诉你个秘密",3000],["44",30,"npc_njk","小哥哥","什么秘密？",3000],["45",30,"npc_herotower2","小姐姐","我知道为什么这里有这么多的奇怪的人。",3000],["46",30,"npc_njk","小哥哥","为什么？",3000],["47",30,"npc_herotower2","小姐姐","告诉你也可以，但是你得帮我个忙。",3000],["48",30,"npc_njk","小哥哥","爱说不说。",3000],["49",40,"npc_herotower2","小姐姐","你这人怎么这样啊！",3000],["50",40,"npc_njk","小哥哥","哎，行吧，你要做什么？",3000],["51",40,"npc_herotower2","小姐姐","你把这些人赶跑，我们到前面那个地方，我就告诉你。",3000],["52",40,"npc_njk","小哥哥","不许骗人哈，骗人是小狗。",3000],["53",50,"npc_njk","小哥哥","好了，可以说了吧，你要敢学小狗叫我就把你丢回去。",3000],["54",50,"npc_herotower2","小姐姐","喵~？",3000],["55",50,"npc_njk","小哥哥","再给你一次机会。",3000],["56",50,"npc_herotower2","小姐姐","好了，一点情趣都没有，告诉你，我是因为得到了一张地图…...",3000],["57",50,"npc_njk","小哥哥","嘘，有人来了。",3000],["58",60,"npc_njk","小哥哥","是不是这张？",3000],["59",60,"npc_herotower2","小姐姐","怎么你也有？",3000],["60",60,"npc_njk","小哥哥","恐怕所有人都有吧。",3000],["61",60,"npc_herotower2","小姐姐","（泄气）我还以为就我有呢。",3000],["62",70,"npc_njk","小哥哥","你可以当做只有你有。",3000],["63",70,"npc_herotower2","小姐姐","算了吧，你说这张图是真的么，为什么到处都是",3000],["64",70,"npc_njk","小哥哥","目前还不清楚，不过看他们兴师动众的，肯定有猫腻。",3000],["65",70,"npc_herotower2","小姐姐","哎呀，看起来，你还不算傻嘛。",3000],["66",70,"npc_njk","小哥哥","不会说话就少说两句，走，我们去那边看看。",3000],["67",80,"npc_njk","小哥哥","我们从这里偷偷溜过去，小心不要被发现。",3000],["68",80,"npc_herotower2","小姐姐","嗯嗯，放心我很厉害。",3000],["69",80,"npc_njk","小哥哥","嗯嗯，被逮到了两次。",3000],["70",80,"npc_herotower2","小姐姐","你别说话。",3000],["71",90,"npc_herotower2","小姐姐","小哥哥，你叫什么名字啊？",3000],["72",90,"npc_njk","小哥哥","你想干嘛？你不要有什么非分之想啊。",3000],["73",90,"npc_herotower2","小姐姐","你去死吧~",3000],["74",90,"npc_njk","小哥哥","哈哈，告诉你，我叫道真。",3000],["75",90,"npc_herotower2","小姐姐","呵，挺巧啊，我叫真真。",3000],["76",90,"npc_njk","小哥哥","我说这么倒霉呢…...",3000],["77",90,"npc_herotower2","小姐姐","（呼…...）我不生气，我不生气。",3000],["78",100,"NPC_moseng","小兵甲","兄弟们，打起精神，上头说了，这事完了犒劳大伙，到时候一起去喝酒",3000],["79",100,"NPC_moseng","小兵甲","好嘞，头，我们在这穷乡僻壤的干啥呢？",3000],["80",100,"NPC_moseng","小兵甲","不该问的少问。",3000],["81",100,"npc_herotower2","小姐姐","看到没，那个小头头可能知道点啥，你去把他抓了。",3000],["82",100,"npc_njk","小哥哥","你咋不去呢？",3000],["83",100,"npc_herotower2","小姐姐","我打不过。",3000],["84",100,"npc_njk","小哥哥","很有道理，我竟无话可说。",3000],["85",110,"NPC_moseng","小兵甲","别…别杀我…...",3000],["86",110,"npc_njk","道真","我问什么你说什么，说错一次我砍一刀。",3000],["87",110,"NPC_moseng","小兵甲","我说，什么都说。",3000],["88",110,"npc_njk","道真","你们在这儿做什么？",3000],["89",110,"NPC_moseng","小兵甲","不知道",3000],["90",110,"npc_njk","道真","嗯，没用了，埋了吧。",3000],["91",120,"NPC_moseng","小兵甲","别~别，别这样，我是真不知道，但是我估计我大哥应该知道，我给你们带路。",3000],["92",120,"npc_herotower2","真真","这还勉强可以，头前带路。",3000],["93",120,"npc_njk","道真","你就这么信了?",3000],["94",120,"npc_herotower2","真真","是啊，你看他说的这么诚恳。",3000],["95",120,"npc_njk","道真","我算是知道你为啥被抓2次了。",3000],["96",120,"NPC_moseng","小兵甲","从这里往前，我们头就在那里。",3000],["97",130,"npc_njk","道真","你在这看着他，我去看看。",3000],["98",130,"npc_herotower2","真真","好，多加小心。",3000],["99",130,"npc_njk","道真","你以为我是你啊？",3000],["100",130,"npc_herotower2","真真","那好，我祝你被人抓住，然后吊起来打。",3000],["101",130,"npc_njk","道真","哈哈哈哈，我去了哈，你看好他。",3000],["102",140,"NPC_moseng","小头目","什么人？",3000],["103",140,"npc_njk","道真","嘘~，接下来听我说，我已经知道你是这的小头目，别问怎么知道的，问就是你的小弟说的。",3000],["104",140,"npc_njk","道真","我只问一次，不满意我就直接把你埋了，你想好再回答。",3000],["105",140,"npc_njk","道真","你们在这儿做什么？",3000],["106",140,"NPC_moseng","小头目","不知道。",3000],["107",150,"npc_njk","道真","你是不是觉得我比较好说话啊？",3000],["108",150,"NPC_moseng","小头目","不敢不敢，我是真不知道，之间那是跟他们吹牛的，这种事我怎么能知道。",3000],["109",150,"npc_njk","道真","好，那我问个你知道的，你们老大在哪儿？",3000],["110",150,"NPC_moseng","小头目","哪个老大？",3000],["111",150,"npc_njk","道真","嗯？你有几个老大，最高级的那种？",3000],["112",150,"NPC_moseng","小头目","哎呀，最近好多老大，都是从各处过来的，有几十个吧。",3000],["113",160,"npc_herotower2","真真","哇，这么兴师动众的，看来真的是有大秘密哦，我们赚了？",3000],["114",160,"npc_njk","道真","（白眼）是你，那么多人打不过，我走了，你自己赚哈。",3000],["115",160,"npc_herotower2","真真","你这人怎么这样啊，你就不好奇嘛？",3000],["116",160,"npc_njk","道真","不好奇",3000],["117",160,"npc_herotower2","真真","那你就不帮帮美女嘛？",3000],["118",160,"npc_njk","道真","嘿嘿，有什么好处？",3000],["119",160,"npc_herotower2","真真","好处嘛，自然是有的。",3000],["120",160,"npc_njk","道真","成交",3000],["121",170,"npc_njk","道真","你过来",3000],["122",170,"NPC_moseng","小头目","啊，叫我吗？",3000],["123",170,"npc_njk","道真","再废话信不信我叫你再也不能说话。",3000],["124",170,"NPC_moseng","小头目","嘿嘿，不敢不敢，您吩咐。",3000],["125",170,"npc_njk","道真","你们来这儿多久了",3000],["126",170,"NPC_moseng","小头目","没多久，三天前吧",3000],["127",180,"npc_njk","道真","这些人你都认识么？",3000],["128",180,"NPC_moseng","小头目","不全认识，只有部分人是我们自己兄弟，其他的都是别处来的。",3000],["129",180,"npc_njk","道真","仔细说说。",3000],["130",180,"NPC_moseng","小头目","大概几天前，我们寨子里来了几个神神秘秘的人，架势很大，跟我们老大在房间里待了很久。",3000],["131",180,"NPC_moseng","小头目","然后我们老大就挑了我们几个说是有一件大富贵的事，带我们到这里来了。",3000],["132",190,"npc_njk","道真","哦，原来这样，后来呢？",3000],["133",190,"NPC_moseng","小头目","后来我们就在这临时扎营了，后面又陆陆续续有其他人从各处来，都是各处的帮派什么的。",3000],["134",190,"npc_herotower2","真真","你们在这几天都在做什么？",3000],["135",190,"NPC_moseng","小头目","也没做什么，就是围着一个那边一个山谷四处查看。",3000],["136",190,"npc_herotower2","真真","查看什么？",3000],["137",190,"NPC_moseng","小头目","我们也不知道啊，有个先生模样的人跟着我们边看边画，还算来算去的，地上做了很多标记。",3000],["138",200,"npc_njk","道真","带我们过去看看。",3000],["139",200,"NPC_moseng","小头目","我给你们指路，你们自己去呗。",3000],["140",200,"npc_njk","道真","你看我像傻子么？",3000],["141",200,"NPC_moseng","小头目","我过去被发现了就死定了。",3000],["142",200,"npc_herotower2","真真","你过去不一定死，你不过去一定死，希望你好自为之。",3000],["143",200,"NPC_moseng","小头目","…...",3000],["144",210,"NPC_moseng","小头目","过来，走这边，前面有人把守，你们去把他们处理下，不然过不去",3000],["145",210,"npc_njk","道真","好，你看着他，我过去。",3000],["146",210,"npc_herotower2","真真","嗯，小心点。",3000],["147",210,"npc_njk","道真","哎呀，你也会温柔的啊？我还以为…..",3000],["148",210,"npc_herotower2","真真","去死吧你！",3000],["149",210,"NPC_moseng","小头目","哎哎哎~这还有人呢。",3000],["150",220,"npc_herotower2","真真","还有多远？",3000],["151",220,"NPC_moseng","小头目","还早呢，我们只是在外围，现在把守的越来越严密了。",3000],["152",220,"npc_herotower2","真真","我现在越来越好奇了。",3000],["153",220,"npc_njk","道真","是挺奇怪的。",3000],["154",230,"npc_njk","道真","给你个机会要不要？",3000],["155",230,"NPC_moseng","小头目","什么机会？",3000],["156",230,"npc_njk","道真","我现在放你回去，你帮我打听打听，有你的好处。",3000],["157",230,"NPC_moseng","小头目","你就不怕我叫人抓你？",3000],["158",240,"npc_njk","道真","怕，所以放你之前要做点准备，喏，把这个给他吃下去。",3000],["159",240,"NPC_moseng","小头目","我不吃，妈妈说不要吃陌生人的东西。",3000],["160",240,"npc_njk","道真","嗯…捏住他嘴巴。",3000],["161",240,"NPC_moseng","小头目","呜~呜~呜~，你给我吃的什么。",3000],["162",240,"npc_njk","道真","没什么，一点毒药而已，放心暂时死不了，不过3天需要服用一次解药，不吃解药的话就会死的很难看哦。",3000],["163",240,"NPC_moseng","小头目","你们真阴险",3000],["164",240,"npc_njk","道真","一般一般了，快去吧，等这事完了就给你彻底解毒。",3000],["165",250,"npc_herotower2","真真","你可真阴险，走路都带毒药的。",3000],["166",250,"npc_njk","道真","什么毒药啊，骗他的，之前从地上捡的不知道什么东西…",3000],["167",250,"npc_herotower2","真真","咦~真恶心",3000],["168",250,"npc_njk","道真","好了，我们暂时在这休息会等消息吧。",3000],["169",260,"npc_njk","道真","我就很奇怪哈，你一个女孩子整天在外面疯，你父母不管你么？",3000],["170",260,"npc_herotower2","真真","要你管…",3000],["171",260,"npc_herotower2","真真","你还不是一样在外面混，你父母不打你么？",3000],["172",260,"npc_njk","道真","要你管…",3000],["173",260,"npc_herotower2","真真","…",3000]]}